type Resolver<T> = (options: ApiRequestOptions) => Promise<T>;
type Headers = Record<string, string>;

export type OpenAPIConfig = {
	BASE: string;
	VERSION: string;
	WITH_CREDENTIALS: boolean;
	CREDENTIALS: 'include' | 'omit' | 'same-origin';
	TOKEN?: string | Resolver<string> | undefined;
	USERNAME?: string | Resolver<string> | undefined;
	PASSWORD?: string | Resolver<string> | undefined;
	HEADERS?: Headers | Resolver<Headers> | undefined;
	ENCODE_PATH?: ((path: string) => string) | undefined;
	ERROR_CALLBACK?: (error: ApiError) => void;
	BEFORE_REQUEST?: (options: ApiRequestOptions) => void{{#equals @root.httpClient 'fetch'}} | Promise<void>{{/equals}};
{{#equals @root.httpClient 'fetch'}}
	ON_REQUEST?: (request: CancelablePromise<any>, options: ApiRequestOptions) => void | (() => void);
	ON_RESPONSE?: (response: Response, options: ApiRequestOptions) => void;
	ON_TRANSPORT_ERROR?: (error: unknown, options: ApiRequestOptions) => void;
	TRANSFORM_TRANSPORT_ERROR?: (error: unknown, options: ApiRequestOptions) => unknown;
	QUERY_SERIALIZER?: (query: Record<string, any>) => string;
{{/equals}}
	AFTER_REQUEST?: (apiResult: ApiResult) => void;
};

export const OpenAPI: OpenAPIConfig = {
	BASE: '{{{server}}}',
